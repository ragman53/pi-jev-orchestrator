{
	"name": "pi-jev-orchestrator",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Cache-aware, work-unit-sticky Jev model routing for Pi.",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun test ./tests",
		"test:integration": "bun test ./tests/integration.test.ts",
		"benchmark": "bun run tests/benchmark.ts",
		"audit": "bun run scripts/audit.ts",
		"check": "bun run typecheck && bun run lint && bun run test"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.0",
		"@earendil-works/pi-ai": "1.4.0",
		"@earendil-works/pi-coding-agent": "1.4.0",
		"@types/bun": "^1.3.0",
		"typescript": "^5.9.3"
	}
}
